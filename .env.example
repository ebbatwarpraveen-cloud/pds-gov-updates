# ---- Copy these into Vercel > Project > Settings > Environment Variables ----
# (never paste secrets in chat)

# Database (Supabase / Neon Postgres connection string)
DATABASE_URL=

# Security
CRON_SECRET=            # long random text. Used by Vercel cron and external schedulers
WEBHOOK_SECRET=         # long random text. Added to the Gupshup callback URL (?key=...)
LINK_SECRET=            # long random text. Signs private page / poster links
PUBLIC_BASE_URL=        # e.g. https://your-project.vercel.app (no trailing slash)

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Website fetching fallback (optional but recommended for JS-heavy / blocking sites)
FIRECRAWL_API_KEY=

# WhatsApp (Gupshup)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=      # your WhatsApp Business number, e.g. 919XXXXXXXXX
GUPSHUP_ALERT_TEMPLATE_ID=  # approved template id for the private alert
OWNER_WHATSAPP=             # owner number, e.g. 916305478376

# Optional: only if Gupshup approved the Groups API for your number
GROUP_SEND_ENABLED=false
GUPSHUP_APP_ID=
GUPSHUP_GROUP_ID=

# Tuning (optional)
SOURCES_PER_RUN=20
MAX_CANDIDATES_PER_RUN=12
HEALTH_MAX_AGE_MIN=1560
